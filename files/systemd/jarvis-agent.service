[Unit]
Description=J.A.R.V.I.S. Ambient Operating System Assistant Daemon
Documentation=https://github.com/jayaraman2212066/PROJECT_AIOS
After=default.target ai-daemon.service
Wants=ai-daemon.service

[Service]
Type=simple
ExecStart=/usr/libexec/jarvis/jarvis-agent.py
Restart=always
RestartSec=3s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
